# DATABASE_URL, STUDIO_PORT, and NODE_ENV are used by `pnpm dev` (local, outside Docker) only —
# the compose stack below sets its own.
DATABASE_URL=postgres://studio:studio@localhost:5433/studio
STUDIO_SECRET_KEY=replace-with-32-bytes-base64
STUDIO_PORT=8080
# STUDIO_TRUST_PROXY=1   # only for the Tunnel / own-proxy paths; the compose stack already sets 1
# STUDIO_PUBLIC_URL=https://your-hostname   # only for the Tunnel / own-proxy paths
NODE_ENV=development

# For deploy/docker-compose.yml
# letters and digits only — embedded directly in a Postgres connection URL
POSTGRES_PASSWORD=change-me
STUDIO_DOMAIN=pay.example.co.ke
STUDIO_VERSION=latest
ACME_EMAIL=admin@example.co.ke

# Cap every single send (cents). 100 = KES 1. Remove once you trust the installation.
# STUDIO_MAX_SEND_CENTS=100

# STUDIO_MODE=hosted     # exists for darajastudio.com; leave commented out — your install is one organisation either way
# STUDIO_EGRESS_IPS=     # hosted only: the addresses Safaricom sees this service coming from, comma-separated

# Hosted signup email confirmation. All five are required together with STUDIO_PUBLIC_URL.
# STUDIO_SMTP_HOST=mail.example.com
# STUDIO_SMTP_PORT=465
# STUDIO_SMTP_USER=noreply@example.com
# STUDIO_SMTP_PASSWORD=replace-with-a-dedicated-mailbox-password
# STUDIO_SMTP_FROM=noreply@example.com
